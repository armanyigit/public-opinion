# —— Database (Postgres + pgvector) ————————————————————————————————
# Matches docker-compose.yml defaults (pgvector/pgvector:pg16).
# Start DB: npm run db:up   (or: docker compose up -d)
# Then:     npm run db:setup  (waits, enables vector, drizzle-kit push)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/public_opinion

# —— Auth.js / NextAuth —————————————————————————————————————————————
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# App origin used by Auth.js (e.g. http://localhost:3000)
AUTH_URL=http://localhost:3000

# Google OAuth (optional until enabled)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# —— Ingest / LLM (workers not wired in this scaffold) ——————————————
# Newsdata.io secondary provider — https://newsdata.io
NEWSDATA_API_KEY=

# LLM for poll drafting (provider TBD; keep key ready)
LLM_API_KEY=

# GDELT DOC 2.0 is public (no key); rate-limit responsibly
# GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
